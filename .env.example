# ============================================================================
# agent-land-breeze-tts-api: every setting you might change lives here.
#
#   cp .env.example .env               # or: python scripts/configure.py   (detects the GPU, writes .env)
#   python scripts/download_models.py  # fetches the model(s) this file selects
#   docker compose up -d --build       # builds and starts the selected runtime
#
# compose.yaml reads only these variables; you shouldn't need to edit it.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
# gguf    = Breeze-TTS-2.cpp (GGUF, ggml CUDA). ~4-5 GB VRAM. Default. Has /usage and warm responses.
# pytorch = original PyTorch runtime. ~17-18 GB VRAM (fast mode), fastest. No warm responses or /usage.
# Run one at a time (both publish BREEZE_PORT).
COMPOSE_PROFILES=gguf

# --- GPU --------------------------------------------------------------------
# Which GPU(s) the container sees: "all", or an index / UUID from `nvidia-smi -L` (e.g. 0).
BREEZE_GPU=all
# GGUF build target = compute capability without the dot (nvidia-smi --query-gpu=compute_cap).
#   86 RTX 30xx/A-series (Ampere) | 89 RTX 40xx/L4/L40 (Ada) | 90 H100 (Hopper) | 120 RTX 50xx (Blackwell)
CUDA_ARCHS=89
# PyTorch runtime only: FlashAttention 2.8.3 builds for 80/90/100/110/120 only.
#   80 for Ampere and Ada (sm80 kernels run on sm86/sm89) | 90 for Hopper
FLASH_ATTN_CUDA_ARCHS=80

# --- Model ------------------------------------------------------------------
# Host folder holding the weights (gguf/ and/or breeze-tts-2/ inside it).
BREEZE_MODELS_DIR=./models
# GGUF file from HoppouAI/Breeze-TTS-2.cpp (download_models.py fetches it into $BREEZE_MODELS_DIR/gguf).
# Tested: breeze-tts-2-q8_0.gguf (see BENCHMARKS.md). Others are untested here:
#   breeze-tts-2-f16.gguf      6.28 GB  reference quality
#   breeze-tts-2-q8_0.gguf     3.57 GB  recommended by upstream; no audible loss vs f16   <- tested
#   breeze-tts-2-q6_k.gguf     3.07 GB
#   breeze-tts-2-q4_k.gguf     2.54 GB  smallest "safe" choice per upstream
#   breeze-tts-2-q8_0-dd4.gguf / -q8_0-dd2.gguf / -q4_k-dd2.gguf   experimental (quantized depth decoder)
# VRAM is roughly file size + 1-2 GB.
BREEZE_GGUF_REPO=HoppouAI/Breeze-TTS-2.cpp
BREEZE_GGUF_FILE=breeze-tts-2-q8_0.gguf
# Breeze-TTS-2.cpp commit the GGUF image builds (tested: a0e177f...).
BREEZE_CPP_COMMIT=a0e177f91242ebbd2ea8d61548d742c89e4b9e06
# PyTorch runtime weights (download_models.py fetches them into $BREEZE_MODELS_DIR/breeze-tts-2).
BREEZE_PYTORCH_REPO=BreezeBlue/Breeze-TTS-2

# --- Network ----------------------------------------------------------------
BREEZE_PORT=7860
# 0.0.0.0 = reachable on the LAN (needs a firewall rule on Windows); 127.0.0.1 = this machine only.
BREEZE_BIND=0.0.0.0

# --- Data folders (host paths) -----------------------------------------------
BREEZE_VOICES_DIR=./voices
BREEZE_RESPONSES_DIR=./responses

# --- Tuning: GGUF runtime -------------------------------------------------------
# --chunk-max N: largest audio piece the engine emits (N/12.5 s). 12 lets warm responses start
# after ~2-2.5 s; 40 is ~8% faster overall but warm playback waits longer (~4-5 s). Add --verbose for engine logs.
BREEZE_ENGINE_ARGS=--chunk-max 12
BREEZE_RESPONSE_TTL_SECONDS=86400
BREEZE_MIN_LEAD_SECONDS=0.75
BREEZE_MAX_PENDING=32
# Warm jobs wait this long for the engine to come back (e.g. after a GPU fault) before failing.
BREEZE_ENGINE_WAIT_SECONDS=60
# Direct /v1/audio/speech requests wait this long for a busy GPU before answering 409 (0 = at once).
BREEZE_SYNC_WAIT_SECONDS=30

# --- Tuning: PyTorch runtime -------------------------------------------------------
# --fast-all: CUDA graphs, ~17 GB, RTF ~0.66 | --no-fast-all: eager, ~9 GB, RTF ~3.2 (slower than real time)
BREEZE_PYTORCH_ARGS=--fast-all

# --- Docker names -------------------------------------------------------------
# Change these to run a second copy side by side (e.g. for testing on another port).
COMPOSE_PROJECT_NAME=breeze-tts
BREEZE_CONTAINER_NAME=breeze-tts
